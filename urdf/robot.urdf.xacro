<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find my_robot_description)/urdf/inertia_macros.xacro"/>

  <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>

  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.4 0.4 0.2"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.4 0.4 0.2"/></geometry>
    </collision>
    <xacro:inertial_box mass="10.0" x="0.4" y="0.4" z="0.2">
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="joint1_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.4"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.4"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="2.0" length="0.4" radius="0.08">
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="joint2_pitch" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.5"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.5"/></geometry>
    </collision>
    <xacro:inertial_box mass="1.5" x="0.1" y="0.1" z="0.5">
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="joint3_roll" type="continuous">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.2"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.2"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.8" length="0.2" radius="0.05">
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="gripper_left_joint" type="prismatic">
    <parent link="link3"/>
    <child link="gripper_left"/>
    <origin xyz="0.03 0 0.2" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.04" effort="5.0" velocity="0.2"/>
  </joint>

  <link name="gripper_left">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.01 0.04 0.1"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.01 0.04 0.1"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.1" x="0.01" y="0.04" z="0.1">
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

</robot>
